{
    "extends": "@tsconfig/vite-react/tsconfig.json",
    "include": ["src/**/*", "test/**/*"],
    "exclude": ["node_modules", "dist"],
    "compilerOptions": {
        "target": "ESNext",
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "noImplicitAny": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "paths": {
            "@src/*": ["./src/*"],
            "@test/*": ["./test/*"],
            "@app/*": ["./src/app/*"],
            "@langs/*": ["./src/app/langs/*"],
            "@modules/*": ["./src/modules/*"]
        }
    }
}
