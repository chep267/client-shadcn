        "@tsconfig/node24": "^24.0.5",
        "@tsconfig/vite-react": "^8.1.1",
        "@types/js-cookie": "^3.0.6",
        "@types/lodash-es": "^4.17.12",
        "@types/node": "^26.5.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
