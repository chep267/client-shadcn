        "vite-plugin-compression": "^0.5.1",
        "vitest": "^5.0.0"
    },
    "lint-staged": {
        "src/**/*.{js,jsx,ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "src/**/*.{json,css,scss,md}": [
            "prettier --write"
        ]
    }
